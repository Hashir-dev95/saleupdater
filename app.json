{
  "expo": {
    "name": "Sales Updater",
    "slug": "SalesUpdater",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salesupdater",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#eef4f2",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f172a",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.whomi.salesUpdater"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#eef4f2",
          "dark": {
            "image": "./assets/images/splash-mark.png",
            "backgroundColor": "#07111f"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "39346f46-a8ca-47bd-a12e-fd4d83f126f4"
      }
    }
  }
}
